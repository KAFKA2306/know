{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/KAFKA2306/know/main/ontology/project.schema.json",
  "title": "KAFKA Project Ontology Manifest",
  "description": "Project-level mapping to the Causal–Evidence Core Ontology.",
  "type": "object",
  "required": [
    "project",
    "purpose",
    "scope",
    "competency_questions",
    "domain_mapping",
    "claims_and_evidence",
    "decision_rules",
    "provenance",
    "validation"
  ],
  "properties": {
    "project": {
      "type": "object",
      "required": ["id", "name", "repository", "version", "updated"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "pattern": "^https://github\\.com/"},
        "pages": {"type": ["string", "null"]},
        "version": {"type": "string", "minLength": 1},
        "updated": {"type": "string", "format": "date"},
        "core_ontology": {"type": "string"}
      },
      "additionalProperties": true
    },
    "purpose": {
      "type": "object",
      "required": ["problem", "intended_decisions", "success_conditions", "falsification_conditions"]
    },
    "scope": {
      "type": "object",
      "required": ["included", "excluded", "temporal", "abstraction_level"]
    },
    "competency_questions": {
      "type": "array",
      "minItems": 3,
      "items": {"type": "string", "minLength": 1}
    },
    "domain_mapping": {
      "type": "object",
      "required": ["System", "State", "Action", "Process", "Observation", "Model", "Requirement", "Claim", "Evidence", "Decision"]
    },
    "claims_and_evidence": {
      "type": "object",
      "required": ["assertion_types", "required_evidence", "unknown_policy"]
    },
    "decision_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "when", "result"]
      }
    },
    "provenance": {
      "type": "object",
      "required": ["sources", "generated_artifacts", "agents", "lineage"]
    },
    "validation": {
      "type": "object",
      "required": ["structural", "semantic", "evidence", "publication"]
    }
  },
  "additionalProperties": true
}
