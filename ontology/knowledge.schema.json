{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/KAFKA2306/know/main/ontology/knowledge.schema.json",
  "title": "Know MkDocs/OKF Knowledge Metadata",
  "description": "Metadata for the canonical MkDocs pages. OKF v0.3-compatible concept metadata, without implying a review occurred.",
  "type": "object",
  "required": ["type", "description", "tags"],
  "properties": {
    "type": {"type": "string", "pattern": "^[a-z][a-z0-9_-]*$"},
    "description": {"type": "string", "minLength": 4},
    "tags": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9/_-]*$"}
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "resource"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "resource": {"type": "string", "minLength": 1},
          "title": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "generated": {
      "type": "object", "required": ["by", "at"],
      "properties": {
        "by": {"type": "string", "minLength": 1},
        "at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": true
    },
    "verified": {
      "type": "array",
      "items": {
        "type": "object", "required": ["by", "at"],
        "properties": {
          "by": {"type": "string", "minLength": 1},
          "at": {"type": "string", "format": "date-time"}
        },
        "additionalProperties": true
      }
    },
    "stale_after": {"type": "string", "format": "date"},
    "status": {"type": "string", "minLength": 1},
    "superseded_by": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
